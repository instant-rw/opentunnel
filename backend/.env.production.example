DATABASE_URL=postgresql://opentunnel:opentunnel@db.example:5432/opentunnel
OPENTUNNEL_HTTP_ADDR=:8080
OPENTUNNEL_BASE_URL=https://api.opts.ink
OPENTUNNEL_FRONTEND_URL=https://opts.ink
OPENTUNNEL_PUBLIC_HOST=opts.ink
OPENTUNNEL_COOKIE_DOMAIN=.opts.ink
OPENTUNNEL_CORS_ORIGINS=https://opts.ink
OPENTUNNEL_SECURE_COOKIES=true
OPENTUNNEL_CAPTURE_BODY_BYTES=262144
OPENTUNNEL_MAX_STORED_REQUESTS=1000
OPENTUNNEL_MAX_IN_FLIGHT=64
OPENTUNNEL_MAX_CHUNK_BYTES=65536
OPENTUNNEL_QUEUE_DEPTH=128
OPENTUNNEL_HEARTBEAT=10s
OPENTUNNEL_HEARTBEAT_GRACE=30s
OPENTUNNEL_REQUEST_TIMEOUT=2m
OPENTUNNEL_LOG_LEVEL=info
